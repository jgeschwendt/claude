#!/usr/bin/env bash
#MISE description="Symlink the harness entries into ~/.claude (--check only reports)"
# Symlink into ~/.claude each entry Claude Code reads through it.
#   ok      already linked here           drift   a real file or foreign link; never overwritten
#   link    was missing, now linked       unlink  a link here for an unlisted entry, removed
#   differs the user-scope perpetual install is not the trunk's plugin.json version
# --check changes nothing (reports missing: / stale: instead) and exits 1 on anything but ok; a plain
# run repairs link/unlink and exits 1 only on drift or a perpetual line other than ok, which only reports.
set -euo pipefail

check=0
home="${CLAUDE_HOME:-$HOME/.claude}"
repo="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd -P)"

case "${1:-}" in
"") ;;
--check) check=1 ;;
*) echo "usage: link [--check]" >&2; exit 2 ;;
esac

entries=(
	rules
	skills
	CLAUDE.md
	settings.json
	settings.local.json
)

status=0
for entry in "${entries[@]}"; do
	dest="$home/$entry"
	if [[ -L "$dest" && "$(readlink "$dest")" == "$repo/$entry" ]]; then
		echo "ok: $entry"
	elif [[ -e "$dest" || -L "$dest" ]]; then # ※ link-never-overwrites
		echo "drift: $entry"
		status=1
	elif ((check)); then
		echo "missing: $entry"
		status=1
	else
		ln -s "$repo/$entry" "$dest"
		echo "link: $entry"
	fi
done

for dest in "$home"/* "$home"/.[!.]*; do
	[[ -L "$dest" && "$(readlink "$dest")" == "$repo/"* ]] || continue
	entry="${dest##*/}"
	[[ " ${entries[*]} " == *" $entry "* ]] && continue
	if ((check)); then
		echo "stale: $entry"
		status=1
	else
		rm "$dest"
		echo "unlink: $entry"
	fi
done

# the mod runs from a versioned copy under plugins/cache, so a trunk change is live only after an update
want="$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$repo/plugins/perpetual/.claude-plugin/plugin.json")"
have="$(jq -r '[.plugins["perpetual@jgeschwendt"][]? | select(.scope == "user") | .version] | unique | join(" ")' "$home/plugins/installed_plugins.json" 2>/dev/null || true)"
if [[ "$have" == "$want" ]]; then
	echo "ok: perpetual $want"
elif [[ -n "$have" ]]; then
	echo "differs: perpetual $have ≠ trunk $want (claude plugin update perpetual@jgeschwendt)"
	status=1
else
	echo "missing: perpetual (claude plugin install perpetual@jgeschwendt)"
	status=1
fi

exit "$status"
