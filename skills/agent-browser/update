#!/usr/bin/env bash
# Bump the agent-browser binary (pinned in the global mise config — the GitHub release's native build), then fetch
# what that build ships without, from the installed version's tag: the skill content `agent-browser skills get`
# serves, into ~/.agent-browser/skill-data, and the discovery stub SKILL.md beside this file, upstream's byte for
# byte. Prints updated / unchanged for the stub.
set -euo pipefail

mise -C "$HOME" --quiet upgrade --bump github:vercel-labs/agent-browser

dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd -P)"
home="${AGENT_BROWSER_HOME:-$HOME/.agent-browser}"
skill="$dir/SKILL.md"
version="$(mise -C "$HOME" x -- agent-browser --version | awk '{print $2}')"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

curl -fsSL --max-time 60 "https://codeload.github.com/vercel-labs/agent-browser/tar.gz/refs/tags/v$version" |
	tar -xz -C "$work" --strip-components 1 \
		"agent-browser-$version/skill-data" "agent-browser-$version/skills/agent-browser/SKILL.md"
stub="$work/skills/agent-browser/SKILL.md"
[[ -f "$work/skill-data/core/SKILL.md" && "$(head -n 1 "$stub")" == "---" ]] &&
	grep -q '^name: agent-browser$' "$stub" || {
	echo "refuse: v$version carries no agent-browser SKILL.md and skill-data/core" >&2
	exit 1
}

mkdir -p "$home"
rm -rf "$home/skill-data.new"
mv "$work/skill-data" "$home/skill-data.new"
rm -rf "$home/skill-data"
mv "$home/skill-data.new" "$home/skill-data"

if cmp -s "$stub" "$skill"; then
	echo "unchanged"
else
	chmod 644 "$stub"
	mv "$stub" "$skill"
	echo "updated"
fi
