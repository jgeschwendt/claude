{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.grove/code/jgeschwendt/claude/main/plugins/subether",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "attribution": {
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(cmake --build *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr merge *)",
      "Bash(git -C ~/.grove/code/* commit *)",
      "Bash(git -C ~/.grove/code/* push --force-with-lease*)",
      "Bash(git push --force-with-lease*)",
      "Bash(mise run -C * check)",
      "Bash(mise run stop *)",
      "Bash(sandman *)",
      "Bash(stele *)",
      "Bash(swift build *)",
      "Bash(xattr -l *)",
      "Edit(~/.grove/code/**)"
    ],
    "defaultMode": "auto"
  },
  "worktree": {
    "baseRef": "fresh",
    "bgIsolation": "none"
  },
  "enabledPlugins": {
    "cowork-plugin-management@synced": false,
    "engineering@synced": false,
    "productivity@synced": false,
    "subether@synced": false,
    "typesafe@typesafe-ai": true,
    "typescript-lsp@claude-plugins-official": true,
    "vercel@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    }
  },
  "effortLevel": "high",
  "askUserQuestionTimeout": "never",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": false,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "normal",
  "verbose": false,
  "preferredNotifChannel": "auto",
  "switchModelsOnFlag": true,
  "autoContinueAtUsageLimit": false,
  "remoteControlAtStartup": false,
  "autoUploadSessions": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "editing ~/.grove/code/jgeschwendt/main/ is allowed",
      "git push --force-with-lease to my non-default branches under ~/.grove/code is routine",
      "stopping a process this session started, by its pid or with `mise run stop`, is routine"
    ]
  },
  "voiceEnabled": true,
  "defaultToAgentsView": false,
  "feedbackSurveyState": {
    "lastShownTime": 1754086909438
  }
}
