{
  "actors": [
    {
      "doc": "the model asks for a tool call",
      "label": "model",
      "name": "model"
    },
    {
      "doc": "Claude Code's core: raises tool.call, then tool.check, runs the tool",
      "label": "engine",
      "name": "engine"
    },
    {
      "doc": "toollog.ts log: the first tool.call hook, so outermost",
      "label": "log",
      "name": "log"
    },
    {
      "doc": "guard.ts bash (Bash) or yml (Edit/Write): the house rules",
      "label": "guard",
      "name": "guard"
    },
    {
      "doc": "check.ts check: core's verdict returned unchanged, an ask judged beside it",
      "label": "tool.check",
      "name": "tool.check"
    },
    {
      "doc": "judge.ts judge: TypeSafe first, Kev as fallback; never awaited by the call",
      "label": "judge (shadow)",
      "name": "judge"
    },
    {
      "doc": "the tool itself",
      "label": "tool",
      "name": "tool"
    }
  ],
  "frames": [
    {
      "first": 4,
      "kind": "alt",
      "label": "a house rule matches",
      "last": 5
    },
    {
      "first": 6,
      "kind": "alt",
      "label": "the guard throws or times out first",
      "last": 6
    },
    {
      "first": 12,
      "kind": "opt",
      "label": "ask · a real call · not read-only — unawaited",
      "last": 15
    },
    {
      "first": 17,
      "kind": "alt",
      "label": "the ask is refused",
      "last": 17
    },
    {
      "first": 20,
      "kind": "alt",
      "label": "the tool fails",
      "last": 20
    }
  ],
  "messages": [
    {
      "from": "model",
      "kind": "call",
      "label": "tool_use",
      "to": "engine"
    },
    {
      "from": "engine",
      "kind": "call",
      "label": "tool.call e",
      "note": "every call, built-in or MCP, main loop or subagent",
      "to": "log"
    },
    {
      "from": "log",
      "kind": "call",
      "label": "next(e)",
      "note": "the guards match Bash, or Edit/Write",
      "to": "guard"
    },
    {
      "from": "guard",
      "kind": "call",
      "label": "decide: read argv as Bash reads it",
      "to": "guard"
    },
    {
      "from": "guard",
      "kind": "write",
      "label": "sandman trail append --kind guard",
      "target": "~/.sandman/trail",
      "to": "guard"
    },
    {
      "from": "guard",
      "kind": "deny",
      "label": "{ deny: \"subether: <rule>.\" }",
      "to": "log"
    },
    {
      "from": "guard",
      "kind": "deny",
      "label": ".catch → deny, fail closed",
      "to": "log"
    },
    {
      "from": "guard",
      "kind": "call",
      "label": "next(e) → core",
      "to": "engine"
    },
    {
      "from": "engine",
      "kind": "call",
      "label": "tool.check e",
      "note": "after the tool.call hooks, before the mode settles an ask",
      "to": "tool.check"
    },
    {
      "from": "tool.check",
      "kind": "call",
      "label": "next(e)",
      "to": "engine"
    },
    {
      "from": "engine",
      "kind": "return",
      "label": "rules · mode · the tool's check → ask",
      "to": "tool.check"
    },
    {
      "from": "tool.check",
      "kind": "return",
      "label": "the verdict, unchanged",
      "to": "engine"
    },
    {
      "from": "tool.check",
      "kind": "call",
      "label": "judge(state, 4 questions)",
      "to": "judge"
    },
    {
      "from": "judge",
      "kind": "call",
      "label": "POST /v1/systemone: TypeSafe, else Kev",
      "to": "judge"
    },
    {
      "from": "judge",
      "kind": "return",
      "label": "four probabilities",
      "to": "tool.check"
    },
    {
      "from": "tool.check",
      "kind": "write",
      "label": "check line",
      "target": "tools/<day>.jsonl",
      "to": "tool.check"
    },
    {
      "from": "engine",
      "kind": "call",
      "label": "the mode settles the ask: auto mode's classifier, or the person",
      "to": "engine"
    },
    {
      "from": "engine",
      "kind": "deny",
      "label": "{ deny }: the mode or the person refuses",
      "to": "guard"
    },
    {
      "from": "engine",
      "kind": "call",
      "label": "run",
      "to": "tool"
    },
    {
      "from": "tool",
      "kind": "return",
      "label": "result",
      "to": "engine"
    },
    {
      "from": "tool",
      "kind": "return",
      "label": "{ isError: true }",
      "to": "engine"
    },
    {
      "from": "engine",
      "kind": "return",
      "label": "result",
      "to": "guard"
    },
    {
      "from": "guard",
      "kind": "return",
      "label": "result",
      "to": "log"
    },
    {
      "from": "log",
      "kind": "write",
      "label": "call line, unawaited: ok · error · denied",
      "target": "tools/<day>.jsonl",
      "to": "log"
    },
    {
      "from": "log",
      "kind": "return",
      "label": "result",
      "to": "engine"
    },
    {
      "from": "engine",
      "kind": "return",
      "label": "tool_result",
      "to": "model"
    }
  ]
}
